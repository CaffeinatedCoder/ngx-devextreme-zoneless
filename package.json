{
  "name": "ngx-devextreme-zoneless",
  "version": "2.0.0",
  "private": false,
  "description": "Strongly-typed signal & zoneless change-detection adapters for DevExtreme Angular components",
  "license": "MIT",
  "author": "Ricardo Gross",
  "homepage": "https://github.com/CaffeinatedCoder/ngx-devextreme-zoneless#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CaffeinatedCoder/ngx-devextreme-zoneless.git"
  },
  "bugs": {
    "url": "https://github.com/CaffeinatedCoder/ngx-devextreme-zoneless/issues"
  },
  "keywords": [
    "angular",
    "devextreme",
    "signals",
    "zoneless",
    "change-detection"
  ],
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.examples.json",
    "typecheck:examples": "ngc -p tsconfig.examples.json",
    "smoke": "ng serve smoke",
    "e2e": "playwright test",
    "probe": "node scripts/bundle-probe.mjs",
    "verify": "npm run build && npm run typecheck:examples",
    "release": "npm run verify && cd dist && npm publish --access public"
  },
  "peerDependencies": {
    "@angular/core": ">=20.0.0 <23.0.0",
    "devextreme": ">=26.1.0",
    "devextreme-angular": ">=26.1.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.7",
    "@angular/cli": "^22.0.7",
    "@angular/common": "^22.0.7",
    "@angular/compiler": "^22.0.7",
    "@angular/compiler-cli": "^22.0.7",
    "@angular/core": "^22.0.7",
    "@angular/forms": "^22.0.7",
    "@angular/platform-browser": "^22.0.7",
    "@playwright/test": "^1.62.1",
    "devextreme": "26.1.3",
    "devextreme-angular": "26.1.3",
    "ng-packagr": "22.0.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "typescript": "6.0.3"
  },
  "sideEffects": false,
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.27.7": true,
    "msgpackr-extract@3.0.4": true,
    "inferno@8.2.3": true,
    "fsevents@2.3.3": true,
    "core-js@3.50.0": true,
    "@parcel/watcher@2.6.0": true,
    "lmdb@3.5.6": true
  }
}
