{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "smoke": {
      "projectType": "application",
      "root": "smoke",
      "sourceRoot": "smoke/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist-smoke",
            "index": "smoke/src/index.html",
            "browser": "smoke/src/main.ts",
            "tsConfig": "tsconfig.smoke.json",
            "styles": ["node_modules/devextreme/dist/css/dx.light.css"],
            "optimization": false,
            "extractLicenses": false,
            "sourceMap": true
          },
          "configurations": {
            "ssr": {
              "server": "smoke/src/main.server.ts",
              "ssr": true
            }
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "smoke:build",
            "port": 4299,
            "proxyConfig": "smoke/proxy.conf.json"
          }
        }
      }
    },
    "probe": {
      "projectType": "application",
      "root": "probe",
      "sourceRoot": "probe/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist-probe",
            "index": "probe/src/index.html",
            "browser": "probe/src/main.ts",
            "tsConfig": "tsconfig.probe.json",
            "optimization": true,
            "outputHashing": "none",
            "extractLicenses": false,
            "sourceMap": false,
            "statsJson": true,
            "budgets": []
          }
        }
      }
    }
  }
}
